{
  "framework": null,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run build:web",
  "builds": [
    { "src": "api/**/*.ts", "use": "@vercel/node" },
    { "src": "dist/public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/dist/public/index.html" }
  ]
}
